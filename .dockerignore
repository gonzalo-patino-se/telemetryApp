# =============================================================================
# Docker build context exclusions
# Keeps the image small and prevents host-specific artifacts (Windows venvs,
# node_modules, local DB) from leaking into the build.
# =============================================================================

# Version control
.git/
.gitignore
.gitattributes

# Secrets - NEVER copy into an image
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (host-specific, Windows binaries)
myenv/
venv/
.venv/
env/
backend/myenv/
backend/venv/
backend/.venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*

# Local database & runtime data
*.sqlite3
backend/db.sqlite3
backend/staticfiles/
backend/media/
backend/logs/
backups/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Docs & misc
docs/
README.md
*.md
!backend/README.md
deploy/ssl/
